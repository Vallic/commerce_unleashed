<?php

/**
 * @file
 * The install file.
 */

use Drupal\commerce_unleashed\Stock\WarehouseStockLedger;
use Drupal\Core\StringTranslation\TranslatableMarkup;

/**
 * Implements hook_schema().
 */
function commerce_unleashed_schema(): array {
  $schema['commerce_unleashed_stock_on_hand'] = [
    'description' => 'Table used for tracking Unleashed stock',
    'fields' => [
      'id' => [
        'description' => 'Primary Key: id.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'ProductCode' => [
        'description' => 'The SKU. Product code at Unleashed.',
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
      ],
      'AllocatedQty' => [
        'description' => 'The allocated quantity ',
        'type' => 'varchar',
        'length' => 16,
        'not null' => TRUE,
      ],
      'AvailableQty' => [
        'description' => 'The available quantity ',
        'type' => 'varchar',
        'length' => 16,
        'not null' => TRUE,
      ],
      'QtyOnHand' => [
        'description' => 'The quantity on hand.',
        'type' => 'varchar',
        'length' => 16,
        'not null' => TRUE,
      ],
      'ProductGuid' => [
        'description' => 'The product variation uuid.',
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
      ],
      'timestamp' => [
        'description' => 'The date and time that any quantity was last updated.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'product_code' => ['ProductCode'],
      'product_guid' => ['ProductGuid'],
    ],
  ];
  $schema[WarehouseStockLedger::TABLE] = _commerce_unleashed_warehouse_stock_schema();

  return $schema;
}

/**
 * The table holding the last Unleashed figures per SKU per counted warehouse.
 *
 * A delta stock pull returns a SKU only from the warehouses where it moved;
 * the last figures for the others come from here.
 *
 * @return array<string, mixed>
 *   The table definition.
 */
function _commerce_unleashed_warehouse_stock_schema(): array {
  $quantity = static fn (string $description): array => [
    'type' => 'float',
    'size' => 'big',
    'not null' => TRUE,
    'default' => 0,
    'description' => $description,
  ];

  return [
    'description' => 'The last Unleashed stock figures per SKU per counted warehouse, which delta stock pulls total from.',
    'fields' => [
      'ProductCode' => [
        'type' => 'varchar_ascii',
        'length' => 255,
        'not null' => TRUE,
        'description' => 'The Unleashed product code (SKU).',
      ],
      'WarehouseCode' => [
        'type' => 'varchar_ascii',
        'length' => 64,
        'not null' => TRUE,
        'description' => 'The Unleashed warehouse code.',
      ],
      'AvailableQty' => $quantity('Available quantity at the warehouse.'),
      'AllocatedQty' => $quantity('Allocated quantity at the warehouse.'),
      'QtyOnHand' => $quantity('Quantity on hand at the warehouse.'),
      'ProductGuid' => [
        'type' => 'varchar_ascii',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
        'description' => 'The Unleashed product guid.',
      ],
      'timestamp' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'When the figures were last written.',
      ],
    ],
    'primary key' => ['ProductCode', 'WarehouseCode'],
    'indexes' => [
      'warehouse' => ['WarehouseCode'],
    ],
  ];
}

/**
 * Implements hook_uninstall().
 */
function commerce_unleashed_uninstall(): void {
  \Drupal::state()->delete(WarehouseStockLedger::SEEDED_STATE_KEY);
}

/**
 * Read attribute sets on product sync, and record the obsolete choice.
 */
function commerce_unleashed_update_10001(): string {
  $config = \Drupal::configFactory()->getEditable('commerce_unleashed.settings');

  // Written explicitly rather than left to the code default, so the setting
  // says what the site does and an admin can see it on the settings form.
  $config
    ->set('products.include_attributes', TRUE)
    ->set('products.include_obsolete', FALSE)
    ->save();

  if ($config->get('products.full')) {
    return (string) new TranslatableMarkup('Product reads now ask for attribute sets. "Fetch each product individually" is still on: it costs one API request per product and does not return the attribute set, so check whether it is still needed.');
  }

  return (string) new TranslatableMarkup('Product reads now ask for attribute sets, so a product record arrives complete instead of the seven brief fields. Obsolete products stay excluded; turn them on under Unleashed settings if the back catalog matters.');
}

/**
 * Record the status sales orders are created with in Unleashed.
 */
function commerce_unleashed_update_10002(): string {
  $config = \Drupal::configFactory()->getEditable('commerce_unleashed.settings');

  // Orders were always created as Placed. Written out so the settings form
  // shows it, and left alone where a site has already chosen.
  if ((string) ($config->get('sales_orders.order_status') ?? '') === '') {
    $config->set('sales_orders.order_status', 'Placed')->save();
  }

  return (string) new TranslatableMarkup('Sales orders are created in Unleashed with the status set under Unleashed settings, Placed unless you change it.');
}

/**
 * Add per-warehouse stock: its table and settings.
 */
function commerce_unleashed_update_10003(): string {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists(WarehouseStockLedger::TABLE)) {
    $schema->createTable(WarehouseStockLedger::TABLE, _commerce_unleashed_warehouse_stock_schema());
  }

  $config = \Drupal::configFactory()->getEditable('commerce_unleashed.settings');
  $defaults = [
    'stock.warehouses' => [],
    'stock.modified_since_days' => 1,
    'stock.full_interval' => 86400,
  ];
  foreach ($defaults as $key => $value) {
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
    }
  }
  $config->save();

  return (string) new TranslatableMarkup('Stock can now be limited to chosen warehouses under Unleashed settings, kept per warehouse and read as deltas with a regular full pull. Until warehouses are chosen, stock is the total across every warehouse, as before.');
}
