<?php

/**
 * @file
 * The install file.
 */

use Drupal\Core\StringTranslation\TranslatableMarkup;

/**
 * Implements hook_schema().
 */
function commerce_unleashed_schema(): array {
  $schema['commerce_unleashed_stock_on_hand'] = [
    'description' => 'Table used for tracking Unleashed stock',
    'fields' => [
      'id' => [
        'description' => 'Primary Key: id.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'ProductCode' => [
        'description' => 'The SKU. Product code at Unleashed.',
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
      ],
      'AllocatedQty' => [
        'description' => 'The allocated quantity ',
        'type' => 'varchar',
        'length' => 16,
        'not null' => TRUE,
      ],
      'AvailableQty' => [
        'description' => 'The available quantity ',
        'type' => 'varchar',
        'length' => 16,
        'not null' => TRUE,
      ],
      'QtyOnHand' => [
        'description' => 'The quantity on hand.',
        'type' => 'varchar',
        'length' => 16,
        'not null' => TRUE,
      ],
      'ProductGuid' => [
        'description' => 'The product variation uuid.',
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
      ],
      'timestamp' => [
        'description' => 'The date and time that any quantity was last updated.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'product_code' => ['ProductCode'],
      'product_guid' => ['ProductGuid'],
    ],
  ];
  return $schema;
}

/**
 * Read attribute sets on product sync, and record the obsolete choice.
 */
function commerce_unleashed_update_10001(): string {
  $config = \Drupal::configFactory()->getEditable('commerce_unleashed.settings');

  // Written explicitly rather than left to the code default, so the setting
  // says what the site does and an admin can see it on the settings form.
  $config
    ->set('products.include_attributes', TRUE)
    ->set('products.include_obsolete', FALSE)
    ->save();

  if ($config->get('products.full')) {
    return (string) new TranslatableMarkup('Product reads now ask for attribute sets. "Fetch each product individually" is still on: it costs one API request per product and does not return the attribute set, so check whether it is still needed.');
  }

  return (string) new TranslatableMarkup('Product reads now ask for attribute sets, so a product record arrives complete instead of the seven brief fields. Obsolete products stay excluded; turn them on under Unleashed settings if the back catalog matters.');
}
