<?php

/**
 * @file
 * Main file.
 */

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_cron().
 */
function commerce_unleashed_cron(): void {
  $last_sync = Drupal::keyValue('commerce_unleashed')->get('stock_on_hand_sync') ?? 0;
  if ($last_sync < time() - 60 * 15) {
    Drupal::service('commerce_unleashed.manager')->syncStockOnHand();
    Drupal::keyValue('commerce_unleashed')->set('stock_on_hand_sync', time());
  }
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function commerce_unleashed_form_commerce_product_variation_type_form_alter(array &$form, FormStateInterface $form_state): void {
  /** @var \Drupal\commerce_product\Entity\ProductTypeInterface $product_type */
  $product_type = $form_state->getFormObject()->getEntity();

  $form['commerce_unleashed'] = [
    '#type' => 'details',
    '#title' => t('Unleashed integration'),
    '#weight' => 5,
    '#open' => FALSE,
    '#tree' => TRUE,
  ];

  $form['commerce_unleashed']['sync'] = [
    '#type' => 'checkbox',
    '#title' => t('Enable synchronization with Unleashed'),
    '#default_value' => $product_type->getThirdPartySetting('commerce_unleashed', 'sync', 0),
    '#required' => FALSE,
  ];

  $form['actions']['submit']['#submit'][] = 'commerce_unleashed_product_variation_type_form_submit';
}

/**
 * Submission handler for
 * commerce_unleashed_form_commerce_product_variation_type_form_alter().
 */
function commerce_unleashed_product_variation_type_form_submit($form, FormStateInterface $form_state): void {
  /** @var \Drupal\commerce_order\Entity\OrderTypeInterface $order_type */
  $order_type = $form_state->getFormObject()->getEntity();
  $settings = $form_state->getValue(['commerce_unleashed']);
  foreach ($settings as $key => $value) {
    $order_type->setThirdPartySetting('commerce_unleashed', $key, $value);
  }
  $order_type->save();
}

/**
 * Implements hook_form_FORM_ID_alter() for 'commerce_order_type_form'.
 */
function commerce_unleashed_form_commerce_order_type_form_alter(array &$form, FormStateInterface $form_state): void {
  /** @var \Drupal\commerce_order\Entity\OrderTypeInterface $order_type */
  $order_type = $form_state->getFormObject()->getEntity();

  $form['commerce_unleashed'] = [
    '#type' => 'details',
    '#title' => t('Unleashed integration'),
    '#weight' => 5,
    '#open' => FALSE,
    '#tree' => TRUE,
  ];

  $form['commerce_unleashed']['sync'] = [
    '#type' => 'checkbox',
    '#title' => t('Enable synchronization with Unleashed'),
    '#default_value' => $order_type->getThirdPartySetting('commerce_unleashed', 'sync', 0),
    '#required' => FALSE,
  ];

  $form['commerce_unleashed']['supplier_code'] = [
    '#type' => 'textfield',
    '#title' => t('Supplier code'),
    '#default_value' => $order_type->getThirdPartySetting('commerce_unleashed', 'supplier_code', ''),
    '#required' => FALSE,
  ];

  $form['actions']['submit']['#submit'][] = 'commerce_unleashed_order_type_form_submit';
}

/**
 * Submission handler for
 * commerce_unleashed_form_commerce_order_type_form_alter().
 */
function commerce_unleashed_order_type_form_submit($form, FormStateInterface $form_state): void {
  /** @var \Drupal\commerce_order\Entity\OrderTypeInterface $order_type */
  $order_type = $form_state->getFormObject()->getEntity();
  $settings = $form_state->getValue(['commerce_unleashed']);
  foreach ($settings as $key => $value) {
    $order_type->setThirdPartySetting('commerce_unleashed', $key, $value);
  }
  $order_type->save();
}
